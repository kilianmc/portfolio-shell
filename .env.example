# URLs of the Module Federation remote entries, one per remote.
# Each defaults (in vite.config.ts) to the production deployment.
# Override for local remote development, e.g.:
# VITE_FUND_REMOTE_URL=http://localhost:5001/remoteEntry.js
VITE_FUND_REMOTE_URL=https://ai-portfolio-project1.vercel.app/remoteEntry.js
# VITE_CLIMB_REMOTE_URL=http://localhost:5002/remoteEntry.js
VITE_CLIMB_REMOTE_URL=https://climb.kilianmc.com/remoteEntry.js

# Show HTML-only example project cards (layout/hover testing only).
# Off by default so production never renders them. Set to true locally, e.g.:
# VITE_SHOW_EXAMPLE_PROJECTS=true
